# Database
DATABASE_URL="postgresql://jobflow:jobflow_dev@localhost:5432/jobflow?schema=public"
SHADOW_DATABASE_URL="postgresql://jobflow:jobflow_dev@localhost:5432/jobflow_shadow?schema=public"

# Auth.js & Multi-User
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Owner credentials (fallback / initial admin seed)
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD_HASH="generate-with-bcrypt-hash-script"

# Transactional Email (Resend)
# Optional in development (defaults to terminal console log fallback)
RESEND_API_KEY=""
EMAIL_FROM="JobFlow AI <notifications@example.com>"

# AI Provider (Google Gemini)
AI_PROVIDER="gemini"
AI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gemini-flash-latest"

# Queue / Background Processing Toggle
QUEUE_ENABLED=false

# LinkedIn Content Manager (Upcoming Steps)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202410"
TOKEN_ENCRYPTION_KEY=""
CRON_SECRET=""
